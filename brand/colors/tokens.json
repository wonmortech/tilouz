  "motion": {
    "easing": {
      "expo": "cubic-bezier(.16,1,.3,1)",
      "spring": "cubic-bezier(.34,1.56,.64,1)",
      "inout": "cubic-bezier(.65,0,.35,1)",
      "sine": "cubic-bezier(.37,0,.63,1)",
      "linear": "linear"
    },
    "duration": {
      "instant": "120ms",
      "fast": "200ms",
      "base": "320ms",
      "slow": "560ms",
      "intro": "1100ms"
    },
    "states": {
      "intro": {
        "label": "Intro (assemble)",
        "duration": "1100 ms",
        "easing": "expo + spring",
        "description": "Halves turn 180 degrees and slide 70 u in from both sides (760 ms, expo); the dot drops in from 90 u above at 560 ms (520 ms, spring). Runs once, then hands over to idle."
      },
      "idle": {
        "label": "Idle",
        "duration": "4.8 s loop",
        "easing": "sine",
        "description": "Halves breathe 5 u apart, the dot floats 6 u. Barely there: the logo is alive, not busy."
      },
      "listening": {
        "label": "Listening",
        "duration": "900 ms loop",
        "easing": "sine",
        "description": "Each half scales vertically 0.78 to 1.08 like an audio level, right half 150 ms behind; the dot pulses 1.3x. Use while the app listens to speech."
      },
      "captioning": {
        "label": "Captioning",
        "duration": "1 s loop",
        "easing": "steps + sine",
        "description": "The dot blinks like a text cursor (steps), the halves type 3 u side to side. Use while live captions are being written."
      },
      "connecting": {
        "label": "Connecting call",
        "duration": "1.8 s loop",
        "easing": "in-out",
        "description": "The right half slides 2R left and joins the left half into an o-ring, the ring turns 360 degrees, then returns to the wave. The dot rests in the counter."
      },
      "loading": {
        "label": "Loading",
        "duration": "1.2 s loop",
        "easing": "linear",
        "description": "The joined ring spins continuously; the dot sits in the counter and breathes. For buttons and small spinners."
      },
      "transition": {
        "label": "Transition",
        "duration": "700 ms once",
        "easing": "in-out",
        "description": "Halves part 24 u and fade, the dot lifts 40 u, then everything returns. Use between screens or when a call ends."
      }
    }
  },
