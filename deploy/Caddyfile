{
	# Admin API only inside the container: deploy/receive.sh reloads config through it.
	admin localhost:2019
	auto_https off
}

:80 {
	# releases/current is a symlink swapped atomically by deploy/receive.sh.
	root * /srv/releases/current
	encode zstd gzip

	# File names are not content-hashed, so the browser revalidates everything (ETag, cheap 304s);
	# fonts never change under the same name.
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=2592000"
	@rest not path /fonts/*
	header @rest Cache-Control "no-cache"

	# The test app (/app/) records video messages and captions speech on the device, so only there
	# camera and microphone are allowed for this origin and recorded clips may play from blob: URLs.
	@app path /app /app/*
	header @app {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), interest-cohort=()"
	}
	@site not path /app /app/*
	header @site {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
	}

	header {
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
